# Environment Variables for RaO
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ─── DATABASE ─────────────────────────────────────────────
# Get these from your Supabase project → Settings → Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── SUPABASE ─────────────────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ─── AI ───────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# ─── PAYMENTS ─────────────────────────────────────────────
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret-here"

# ─── MESSAGING ────────────────────────────────────────────
# WhatsApp Business API or Twilio
WHATSAPP_API_KEY="your-whatsapp-api-key-here"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"

# ─── APP ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
